# GramSathi AI — Backend Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# DO NOT COMMIT .env WITH REAL CREDENTIALS.

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@<cluster-url>/gramsathi?retryWrites=true&w=majority
# Example Local MongoDB URI: mongodb://localhost:27017/gramsathi
MONGODB_URI=

# Dataset & Pipeline Configuration
# DRY_RUN=true prevents any writes to the database, outputting validation reports only.
PIPELINE_DRY_RUN=true
DEFAULT_STATE_FILTER=Maharashtra

# Authentication & Security
# Generate a strong 256-bit secret key for production: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
